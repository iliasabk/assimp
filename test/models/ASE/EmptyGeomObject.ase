*3DSMAX_ASCIIEXPORT	200
*COMMENT "regression test: GEOMOBJECT without faces must not crash the importer"
*SCENE {
	*SCENE_FILENAME "x.max"
	*SCENE_FIRSTFRAME 0
	*SCENE_LASTFRAME 0
	*SCENE_FRAMESPEED 30
	*SCENE_TICKSPERFRAME 160
}
*MATERIAL_LIST {
	*MATERIAL_COUNT 2
	*MATERIAL 0 {
		*MATERIAL_NAME "a"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0 0 0
		*MATERIAL_DIFFUSE 0 0 0
		*MATERIAL_SPECULAR 0 0 0
	}
	*MATERIAL 1 {
		*MATERIAL_NAME "b"
		*MATERIAL_CLASS "Standard"
		*MATERIAL_AMBIENT 0 0 0
		*MATERIAL_DIFFUSE 0 0 0
		*MATERIAL_SPECULAR 0 0 0
	}
}
*GEOMOBJECT {
	*NODE_NAME "tri"
	*NODE_TM {
		*NODE_NAME "tri"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1 0 0
		*TM_ROW1 0 1 0
		*TM_ROW2 0 0 1
		*TM_ROW3 0 0 0
		*TM_POS 0 0 0
		*TM_ROTAXIS 0 0 1
		*TM_ROTANGLE 0
		*TM_SCALE 1 1 1
		*TM_SCALEAXIS 0 0 0
		*TM_SCALEAXISANG 0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 3
		*MESH_NUMFACES 1
		*MESH_VERTEX_LIST {
			*MESH_VERTEX 0 0 0 0
			*MESH_VERTEX 1 1 0 0
			*MESH_VERTEX 2 0 1 0
		}
		*MESH_FACE_LIST {
			*MESH_FACE 0: A: 0 B: 1 C: 2 AB: 1 BC: 1 CA: 1	*MESH_SMOOTHING 1	*MESH_MTLID 0
		}
	}
	*PROP_MOTIONBLUR 0
	*PROP_CASTSHADOW 1
	*PROP_RECVSHADOW 1
	*MATERIAL_REF 0
}
*GEOMOBJECT {
	*NODE_NAME "empty_mesh"
	*NODE_TM {
		*NODE_NAME "empty_mesh"
		*INHERIT_POS 0 0 0
		*INHERIT_ROT 0 0 0
		*INHERIT_SCL 0 0 0
		*TM_ROW0 1 0 0
		*TM_ROW1 0 1 0
		*TM_ROW2 0 0 1
		*TM_ROW3 0 0 0
		*TM_POS 0 0 0
		*TM_ROTAXIS 0 0 1
		*TM_ROTANGLE 0
		*TM_SCALE 1 1 1
		*TM_SCALEAXIS 0 0 0
		*TM_SCALEAXISANG 0
	}
	*MESH {
		*TIMEVALUE 0
		*MESH_NUMVERTEX 0
		*MESH_NUMFACES 0
		*MESH_VERTEX_LIST {
		}
		*MESH_FACE_LIST {
		}
	}
	*PROP_MOTIONBLUR 0
	*PROP_CASTSHADOW 1
	*PROP_RECVSHADOW 1
	*MATERIAL_REF 1
}
